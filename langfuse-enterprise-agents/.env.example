# ---------- Runtime ----------
APP_ENV=dev                      # dev | test | staging | prod  (becomes the Langfuse environment)
RELEASE=0.1.0                    # tagged on every trace; attribute regressions to a deployment
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ---------- LLM provider ----------
# mock   -> deterministic offline LLM (no key needed; great for demos/CI)
# openai -> OpenAI API
# azure  -> Azure OpenAI (LLM_MODEL = deployment name)
# ollama -> local Ollama via OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Agent limits ----------
AGENT_MAX_STEPS=6
AGENT_MAX_INPUT_CHARS=4000

# ---------- Langfuse observability ----------
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000        # self-hosted; cloud: https://cloud.langfuse.com or https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=                       # pk-lf-...
LANGFUSE_SECRET_KEY=                       # sk-lf-...
LANGFUSE_SAMPLE_RATE=1.0                   # head sampling (1.0 = trace everything)
LANGFUSE_FLUSH_AT=15                       # batch size before an export
LANGFUSE_AUTH_CHECK=true                   # verify credentials at start-up
LANGFUSE_PROMPT_MANAGEMENT=false           # true = fetch system prompts from Langfuse
LANGFUSE_PROMPT_LABEL=production

# ---------- Security ----------
REDACT_PII_IN_TRACES=true                  # also installs the Langfuse mask callback
REDACT_PII_IN_PROMPTS=true
API_KEY=change-me-in-a-secret-store        # X-API-Key for the REST service

# ---------- Evaluation ----------
EVAL_DATASET_NAME=enterprise-agent-regression
EVAL_MAX_CONCURRENCY=4
EVAL_USE_LLM_JUDGE=false                   # true = add the groundedness LLM judge (needs a real LLM key)
EVAL_JUDGE_MODEL=gpt-4o-mini
