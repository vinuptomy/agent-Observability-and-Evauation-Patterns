# Copy to .env (never commit it). Only the variables for the judge you use are needed.
AGENTIC_EVAL_JUDGE=mock                 # mock | openai | azure_openai | anthropic | <custom registered name>
AGENTIC_EVAL_JUDGE_MODEL=gpt-4o-mini
AGENTIC_EVAL_LOG_LEVEL=INFO
AGENTIC_EVAL_OTEL=false

# OpenAI (or any OpenAI-compatible gateway: vLLM, LiteLLM, Ollama -> OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Azure OpenAI — leave AZURE_OPENAI_API_KEY empty to use Entra ID (DefaultAzureCredential / managed identity)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic
ANTHROPIC_API_KEY=

# Observability backends (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
