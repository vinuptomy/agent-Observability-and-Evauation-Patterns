# ---------- Runtime ----------
APP_ENV=dev                      # dev | test | staging | prod
RELEASE=0.1.0                    # recorded on every trace; attribute regressions to a deployment
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ---------- LLM provider ----------
# mock   -> deterministic offline LLM (no key needed; great for demos/CI)
# openai -> OpenAI API
# azure  -> Azure OpenAI (LLM_MODEL = deployment name)
# ollama -> local Ollama via OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Agent limits ----------
AGENT_MAX_STEPS=6
AGENT_MAX_INPUT_CHARS=4000

# ---------- Arize Phoenix / OpenTelemetry ----------
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces   # OTLP endpoint (any OTLP collector works)
PHOENIX_BASE_URL=http://localhost:6006                       # REST API: datasets, experiments, annotations
PHOENIX_API_KEY=                                             # Phoenix Cloud / secured self-hosted
PHOENIX_PROJECT_NAME=enterprise-agents
PHOENIX_PROTOCOL=http/protobuf                               # http/protobuf | grpc
PHOENIX_AUTO_INSTRUMENT=false                                # true = auto-instrument installed SDKs
PHOENIX_ANNOTATE_GUARDRAILS=true                             # write guardrail outcomes as span annotations

# ---------- Security ----------
REDACT_PII_IN_TRACES=true
REDACT_PII_IN_PROMPTS=true
API_KEY=change-me-in-a-secret-store        # X-API-Key for the REST service

# ---------- Evaluation ----------
EVAL_DATASET_NAME=enterprise-agent-regression
EVAL_MAX_CONCURRENCY=4
EVAL_USE_LLM_JUDGE=false                   # true = phoenix.evals classifiers (needs a model key)
EVAL_JUDGE_MODEL=gpt-4o-mini
