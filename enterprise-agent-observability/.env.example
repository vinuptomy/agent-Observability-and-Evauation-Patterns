# ---------- Runtime ----------
APP_ENV=dev                      # dev | test | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ---------- LLM provider ----------
# mock   -> deterministic offline LLM (no key needed; great for demos/CI)
# openai -> OpenAI API
# azure  -> Azure OpenAI (LLM_MODEL = deployment name)
# ollama -> local Ollama via OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Agent limits ----------
AGENT_MAX_STEPS=6
AGENT_MAX_INPUT_CHARS=4000

# ---------- Opik observability ----------
OPIK_ENABLED=true
OPIK_USE_LOCAL=true              # true = self-hosted Opik, false = Comet cloud
OPIK_URL=                        # e.g. http://localhost:5173/api (self-hosted override)
OPIK_API_KEY=                    # cloud only
OPIK_WORKSPACE=                  # cloud only
OPIK_PROJECT_NAME=enterprise-agents

# ---------- Security ----------
REDACT_PII_IN_TRACES=true
REDACT_PII_IN_PROMPTS=true
API_KEY=change-me-in-a-secret-store   # X-API-Key for the REST service

# ---------- Evaluation ----------
EVAL_USE_LLM_JUDGE=false         # true = add Opik Hallucination & AnswerRelevance (needs a real LLM key)
EVAL_JUDGE_MODEL=gpt-4o-mini
